# Copia este archivo como .env y rellena con tus valores de Supabase
# Los encuentras en: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ─────────────────────────────────────────────────────
# Carpeta de Google Drive para la evidencia de los juegos
# ─────────────────────────────────────────────────────
# Todos los niveles usan este mismo enlace. Los estudiantes suben ahí
# su foto o vídeo como evidencia de haber completado el reto.
# La app NO almacena archivos: solo redirige a este enlace.
#
# Cómo obtenerlo: abre tu carpeta en Google Drive → Compartir →
# Copiar enlace. Debe empezar con https://
VITE_EVIDENCE_DRIVE_URL=https://drive.google.com/drive/folders/PEGAR_AQUI_ID_DE_LA_CARPETA
